# Template for backend/.env. Copy it to .env (never committed) and fill in the real values.
# Format: KEY=value, one per line, no quotes, no spaces around "=". Lines starting with # are comments.
# Loaded by Spring Boot through spring.config.import (application.properties).
# Real environment variables take precedence over this file.

# MongoDB Atlas connection string, used only with the "atlas" profile.
# Atlas > Database > Clusters > Connect > Drivers (Java). URL-encode the password if it contains @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=medikart-backend
